{
  "uid": "medallion-pipeline",
  "title": "Medallion \u00b7 Pipeline (bronze \u2192 silver \u2192 gold)",
  "description": "Runs, freshness, Pipeline Lag, High-Water Mark, data checks, logs and traces of the PySpark Pipeline.",
  "tags": [
    "medallion",
    "pipeline"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "mysql",
          "uid": "starrocks"
        },
        "query": "SELECT run_id FROM ops.pipeline_runs ORDER BY started_at DESC LIMIT 50",
        "definition": "SELECT run_id FROM ops.pipeline_runs ORDER BY started_at DESC LIMIT 50",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "iconColor": "rgba(0, 211, 255, 1)"
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "medallion"
      ],
      "asDropdown": true,
      "title": "Medallion dashboards",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Last run",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Status",
      "description": "FAILED \u2192 open the run in the table below (error column, logs, trace). Gold kept its previous version.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "last_over_time(medallion_pipeline_last_run_success[1d])",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "SUCCESS",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "FAILED",
                  "color": "red",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "NO RUN YET",
                  "color": "orange",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
