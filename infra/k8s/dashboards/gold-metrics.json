    {
      "type": "stat",
      "title": "Active share",
      "description": "Active / non-deleted Users.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "rawSql": "SELECT SUM(CASE WHEN status = 'active' THEN user_count ELSE 0 END) / SUM(user_count) AS active_share\nFROM gold.user_status_summary WHERE status <> 'deleted'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "datasource": {
