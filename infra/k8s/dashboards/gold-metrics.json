    {
      "type": "timeseries",
      "title": "Cumulative signups",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "rawSql": "SELECT CAST(signup_date AS DATETIME) AS time, SUM(signups) OVER (ORDER BY signup_date) AS total_signups\nFROM gold.daily_signups\nORDER BY time",
