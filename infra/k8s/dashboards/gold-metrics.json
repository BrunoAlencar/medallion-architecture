    {
      "type": "barchart",
      "title": "Users by country and status",
      "description": "gold.users_by_country (non-deleted Users).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "rawSql": "SELECT country,\n       SUM(CASE WHEN status = 'active' THEN user_count ELSE 0 END)    AS active,\n       SUM(CASE WHEN status = 'inactive' THEN user_count ELSE 0 END)  AS inactive,\n       SUM(CASE WHEN status = 'suspended' THEN user_count ELSE 0 END) AS suspended\nFROM gold.users_by_country\nGROUP BY country\nORDER BY active + inactive + suspended DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "mysql",
        "uid": "starrocks"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "stacking": "normal",
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "xTickLabelRotation": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
