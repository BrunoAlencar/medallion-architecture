    {
      "type": "stat",
      "title": "Gold built",
      "description": "When the last Pipeline run swapped gold in.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "rawSql": "SELECT UNIX_TIMESTAMP(MAX(built_at)) * 1000 AS built_at FROM gold.users_by_country",
          "format": "table",
