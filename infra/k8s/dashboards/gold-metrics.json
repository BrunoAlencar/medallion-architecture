    {
      "type": "timeseries",
      "title": "Daily signups",
      "description": "gold.daily_signups by Signup Date (created_at). Initial users are spread over the last 180 days.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "rawSql": "SELECT CAST(signup_date AS DATETIME) AS time, signups\nFROM gold.daily_signups\nWHERE $__timeFilter(signup_date)\nORDER BY time",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "mysql",
        "uid": "starrocks"
      },
