# Local development credentials for the kind POC. NOT secrets: never reuse them outside this cluster.
# `make secrets` loads this file into a Secret called `medallion-credentials` in every namespace,
# and the Makefile exports the same values to Helm. Change a value, then run `make secrets` and restart the pods that use it.

# SeaweedFS S3 identity (used by Kafka Connect, Spark, Lakekeeper, StarRocks, Loki, Tempo, Mimir)
S3_ACCESS_KEY=medallion
S3_SECRET_KEY=medallion-dev-secret-key
S3_REGION=us-east-1
# Signs SeaweedFS STS session tokens, so Lakekeeper can vend temporary credentials (base64, 32 bytes)
SEAWEEDFS_STS_SIGNING_KEY=uiAlAVpONd7EGgKmuShZdsK67QvougOwD0WgxDMQwuY=

# Lakekeeper catalog database
LAKEKEEPER_PG_PASSWORD=lakekeeper-dev
LAKEKEEPER_ENCRYPTION_KEY=medallion-dev-encryption-key-change-me

# StarRocks users
STARROCKS_ROOT_PASSWORD=starrocks-root-dev
STARROCKS_PIPELINE_PASSWORD=pipeline-dev
STARROCKS_MCP_READER_PASSWORD=mcp-reader-dev
STARROCKS_GRAFANA_PASSWORD=grafana-reader-dev

# Grafana admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
